# ==============================================================================
# LedgerLens Environment Configuration
# ==============================================================================

# Server Environment: production | staging | development
ENVIRONMENT=development

# Server Host & Port
HOST=127.0.0.1
PORT=8000
WORKERS=1

# CORS Allowed Origins (comma-separated)
# In production, restrict to your domain(s), e.g. https://app.example.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8501,http://127.0.0.1:8501,http://localhost:3000

# Security: Maximum file upload size in bytes (10 MB = 10485760)
MAX_UPLOAD_BYTES=10485760

# Rate Limiting (slowapi format: "X/second", "Y/minute", "Z/day")
RATE_LIMIT=30/minute

# Optional API Key Authentication (Leave empty or unset to disable auth for local development)
API_KEY=

# ML Model Configuration
MODEL_PATH=models/logistic_regression.pkl

# Logging: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Invoices Data Store Path
INVOICES_STORE_PATH=outputs/predictions/processed_invoices.json

# Model Comparison Report Path
MODEL_COMPARISON_PATH=outputs/reports/model_comparison.csv
